{
  "expo": {
    "name": "PlazaGo",
    "slug": "PlazaGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconPlazaGO.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/iconPlazaGO.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F1E9"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconPlazaGO.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.gorda47.PlazaGo"
    },
    "web": {
      "favicon": "./assets/iconPlazaGO.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
