{
  "expo": {
    "name": "PlazaGo",
    "slug": "PlazaGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconPlazaGO.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconPlazaGO.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.gorda47.PlazaGo"
    },
    "web": {
      "favicon": "./assets/iconPlazaGO.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/iconPlazaGO.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3F1E9",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "52c114ef-cacd-4921-bf6c-cacbb5b891c7"
      }
    }
  }
}
